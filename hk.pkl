amends "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Config.pkl"

// AIDEV-NOTE: each package contributes its own biome and test steps through packages/*/hk.pkl
// (all amend hk.package.pkl). The root keeps the workspace-wide steps and the hook-wide settings.
subprojects = List("packages/*")

local rootCheck = new Mapping<String, Step> {
  ["commitlint"] {
    check = "task --silent commitlint"
    profiles = List("ci")
  }
}

local heavy = new Mapping<String, Step> {
  // AIDEV-NOTE: package tests (packages/*:test) and test:scripts depend on this one step
  ["build"] {
    check = "task --silent build"
    profiles = List("ci")
  }
  ["test:scripts"] {
    check = "bun test scripts"
    depends = List("build")
    profiles = List("ci")
  }
  ["docs:build"] {
    check = "task --silent docs:build"
    profiles = List("full")
  }
}

hooks {
  ["check"] {
    steps {
      ...rootCheck
      ...heavy
    }
  }
  ["fix"] {
    fix = true
  }
  ["pre-commit"] {
    fix = true
    stash = "git"
  }
  ["commit-msg"] {
    steps {
      ["commitlint"] {
        check = "task --silent commitlint:edit -- {{commit_msg_file}}"
      }
    }
  }
}
