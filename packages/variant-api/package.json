{
  "name": "variant-api",
  "version": "0.0.5",
  "description": "Database variant lifecycle library",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./commands": {
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js"
    }
  },
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts ./src/commands.ts --outdir dist --target node --format esm --sourcemap=external --external yaml --external drizzle-orm --external postgres --external mysql2 --external tinyglobby --external variant-config --external smol-toml",
    "build:types": "tsc --emitDeclarationOnly",
    "prepublishOnly": "bun run build",
    "test": "VARIANT_OPEN=0 bun test"
  },
  "homepage": "https://github.com/jubr/variant-worktrees",
  "repository": {
    "type": "git",
    "url": "https://github.com/jubr/variant-worktrees.git",
    "directory": "packages/variant-api"
  },
  "keywords": [
    "variant",
    "database",
    "worktree"
  ],
  "files": [
    "dist"
  ],
  "author": "Zach Caceres (@zachcaceres)",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.24.4",
    "postgres": "^3.4.9",
    "smol-toml": "^1.8.0",
    "tinyglobby": "^0.2.17",
    "variant-config": "workspace:*",
    "yaml": "^2.9.1"
  }
}
