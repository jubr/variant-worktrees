{
  "name": "variant-log",
  "version": "0.0.9",
  "description": "Shared log events for variant packages",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bundle": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts --outdir dist --target node --format esm --sourcemap=external",
    "build:types": "tsc --emitDeclarationOnly",
    "test": "bun test"
  },
  "homepage": "https://github.com/jubr/variant-worktrees",
  "repository": {
    "type": "git",
    "url": "https://github.com/jubr/variant-worktrees.git",
    "directory": "packages/variant-log"
  },
  "files": ["dist"],
  "license": "MIT"
}
