{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "db": {
      "type": "object",
      "properties": {
        "dialect": {
          "type": "string",
          "enum": [
            "postgres",
            "mysql",
            "sqlite"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string"
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "ssl": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "variant": {
      "type": "object",
      "properties": {
        "main": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "abbr": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "prefix": {
          "type": "string",
          "minLength": 1
        },
        "baseBranch": {
          "type": "string",
          "minLength": 1
        },
        "branchPrefixes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "format": "ends_with",
            "pattern": ".*\\/$"
          }
        },
        "containerEngine": {
          "type": "string",
          "enum": [
            "docker",
            "podman"
          ]
        },
        "open": {
          "type": "boolean"
        },
        "ports": {
          "type": "object",
          "properties": {
            "range": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "storage": {
          "type": "object",
          "properties": {
            "dir": {
              "type": "string",
              "minLength": 1
            },
            "envVarName": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "run": {
                "type": "string",
                "minLength": 1
              },
              "dir": {
                "type": "string",
                "minLength": 1
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "filterLinesRegex": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "run"
            ],
            "additionalProperties": false
          }
        },
        "supervise": {
          "type": "object",
          "properties": {
            "startDelaySeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "readyTimeoutSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "checkoutPollSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "implode": {
          "type": "object",
          "properties": {
            "preRm": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "discard": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "requireMerged": {
              "type": "boolean"
            },
            "maxDiffLines": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "ui": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "seed": {
          "type": "string",
          "minLength": 1
        },
        "instances": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "vite",
                  "nestjs"
                ]
              },
              "dir": {
                "type": "string",
                "minLength": 1
              },
              "up": {
                "type": "string",
                "minLength": 1
              },
              "watch": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "env": {
                "type": "object",
                "properties": {
                  "sourceFile": {
                    "type": "string",
                    "minLength": 1
                  },
                  "overrides": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "install": {
                "type": "string",
                "minLength": 1
              },
              "ready": {
                "type": "string",
                "format": "starts_with",
                "pattern": "^\\/.*"
              },
              "container": {
                "type": "object",
                "properties": {
                  "dockerfile": {
                    "type": "string",
                    "minLength": 1
                  },
                  "internalPort": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "dockerfile"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "dir"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "variants": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "seed": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "chatRenamer": {
      "type": "object",
      "properties": {
        "trigger": {
          "type": "string",
          "enum": [
            "titleEvent",
            "hook"
          ],
          "description": "What renames a chat: Cursor's title event, or a beforeSubmitPrompt hook."
        },
        "hookScope": {
          "type": "string",
          "enum": [
            "workspace",
            "user"
          ],
          "description": "Where the hook is installed when trigger is hook: the first workspace folder or the user home."
        },
        "activationPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Regular expressions tested against each prompt line; the first capture group becomes the chat title."
        },
        "worktreePrefixes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Worktree directory prefixes including their connector, such as _v-, that name a chat when dragged in."
        },
        "renameExistingDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Rename existing chats created within this many days. 0 turns it off."
        },
        "titleEventPromptLines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Lines of a chat's first prompt that the title event tests for a rename request. At least 1."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
