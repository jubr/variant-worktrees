{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "db": {
      "type": "object",
      "properties": {
        "dialect": {
          "type": "string",
          "enum": [
            "postgres",
            "mysql",
            "sqlite"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string"
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "ssl": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "variant": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string",
          "minLength": 1
        },
        "up": {
          "type": "string",
          "minLength": 1
        },
        "watch": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "string",
          "minLength": 1
        },
        "cacheDir": {
          "type": "string",
          "minLength": 1
        },
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "vite",
                  "nestjs"
                ]
              },
              "dir": {
                "type": "string",
                "minLength": 1
              },
              "up": {
                "type": "string",
                "minLength": 1
              },
              "watch": {
                "type": "string",
                "minLength": 1
              },
              "open": {
                "type": "string",
                "minLength": 1
              },
              "dotenv": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "dir"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "variants": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "seed": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "chatRenamer": {
      "type": "object",
      "properties": {
        "trigger": {
          "type": "string",
          "enum": [
            "titleEvent",
            "hook"
          ],
          "description": "What renames a chat: Cursor's title event, or a beforeSubmitPrompt hook."
        },
        "hookScope": {
          "type": "string",
          "enum": [
            "workspace",
            "user"
          ],
          "description": "Where the hook is installed when trigger is hook: the first workspace folder or the user home."
        },
        "activationPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Regular expressions tested against each prompt line; the first capture group becomes the chat title."
        },
        "worktreePrefixes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Worktree directory prefixes including their connector, such as _v-, that name a chat when dragged in."
        },
        "renameExistingDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Rename existing chats created within this many days. 0 turns it off."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
