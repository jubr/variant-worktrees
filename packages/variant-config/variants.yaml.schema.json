{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "db": {
      "type": "object",
      "properties": {
        "dialect": {
          "type": "string",
          "enum": [
            "postgres",
            "mysql",
            "sqlite"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string"
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "ssl": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "seed": {
      "type": "string",
      "minLength": 1
    },
    "variant": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string",
          "minLength": 1
        },
        "up": {
          "type": "string",
          "minLength": 1
        },
        "watch": {
          "type": "string",
          "minLength": 1
        },
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "vite",
                  "nestjs"
                ]
              },
              "dir": {
                "type": "string",
                "minLength": 1
              },
              "up": {
                "type": "string",
                "minLength": 1
              },
              "watch": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "dir"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "variants": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "seed": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
