{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runtime": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "up",
            "watch"
          ]
        },
        "dir": {
          "type": "string",
          "minLength": 1
        },
        "db": {
          "type": "object",
          "properties": {
            "dialect": {
              "type": "string",
              "enum": [
                "postgres",
                "mysql",
                "sqlite"
              ]
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "host": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^(\\d+|\\{\\{[A-Za-z_][A-Za-z0-9_]*\\}\\})$"
                }
              ]
            },
            "user": {
              "type": "string",
              "minLength": 1
            },
            "password": {
              "type": "string"
            },
            "database": {
              "type": "string",
              "minLength": 1
            },
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "filename": {
              "type": "string",
              "minLength": 1
            },
            "ssl": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "instances": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "port": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "pid": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "url": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": {}
}
