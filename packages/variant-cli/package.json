{
  "name": "variant-cli",
  "version": "0.0.12",
  "description": "The variant command: database variants for git worktrees",
  "type": "module",
  "bin": {
    "variant": "./dist/cli.js"
  },
  "exports": {
    "./bundle": "./src/cli.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/cli.js"
    }
  },
  "config": {
    "slow_tests": "src/commands/completions-shells.spec.ts"
  },
  "scripts": {
    "build": "bun run build:js && bun run build:ui && bun run build:types && chmod +x dist/cli.js",
    "build:js": "bun ../../scripts/build-cli.ts",
    "build:ui": "bun run scripts/build-ui.ts",
    "build:types": "tsc --emitDeclarationOnly",
    "prepublishOnly": "bun run build",
    "test": "export VARIANT_OPEN=0; set -x; bun test ${npm_package_config_slow_tests//src\\//--path-ignore-patterns src\\/}",
    "test:slow": "export VARIANT_OPEN=0; set -x; bun test $npm_package_config_slow_tests"
  },
  "homepage": "https://github.com/jubr/variant-worktrees",
  "repository": {
    "type": "git",
    "url": "https://github.com/jubr/variant-worktrees.git",
    "directory": "packages/variant-cli"
  },
  "keywords": [
    "variant",
    "database",
    "worktree",
    "cli"
  ],
  "files": [
    "dist"
  ],
  "author": "Jurgen Braam (@jubr)",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "cleye": "^2.6.0",
    "variant-api": "workspace:*",
    "variant-ipc": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "variant-mcp": "workspace:*",
    "variant-server": "workspace:*",
    "variant-ui": "workspace:*"
  }
}
