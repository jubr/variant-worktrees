{
  "name": "variant-vscode",
  "version": "0.0.1",
  "description": "Variant VS Code extension",
  "displayName": "Variant",
  "publisher": "variant",
  "main": "./dist/extension.cjs",
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "dependencies": {
    "@types/vscode": "^1.86.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@vscode/vsce": "^2.23.0",
    "esbuild": "^0.20.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "echo 'Open this directory in VSCode and then run your extension with F5 or `Run and Debug > Run Extension`!'",
    "build": "bun run ./scripts/build-with-esbuild.ts",
    "watch": "bun run ./scripts/watch-with-esbuild.ts",
    "vsce-package": "vsce package",
    "package": "bun run build && bun run vsce-package",
    "clean": "rm -rf ./dist",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jubr/variant-worktrees.git",
    "directory": "packages/variant-vscode"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "activationEvents": [
    "onCommand:variant-vscode.helloworld",
    "onCommand:variant-vscode.probeCursorCommands"
  ],
  "contributes": {
    "commands": [
      {
        "command": "variant-vscode.helloworld",
        "title": "Variant: Hello World"
      },
      {
        "command": "variant-vscode.probeCursorCommands",
        "title": "Variant: Probe Cursor Chat Commands"
      }
    ]
  }
}
