{
  "name": "variant-worktrees",
  "version": "0.0.7",
  "description": "Isolated work+db for agents+yourself :: watches, seed, implode :: cli, mcp & vscode",
  "displayName": "Variant Worktrees",
  "publisher": "jubr",
  "icon": "media/icon-256.png",
  "main": "./dist/extension.cjs",
  "dependencies": {
    "@types/vscode": "^1.101.0",
    "chat-renamer": "workspace:*",
    "variant-api": "workspace:*",
    "variant-config": "workspace:*",
    "variant-ipc": "workspace:*",
    "variant-ui": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@vscode/vsce": "^2.23.0",
    "esbuild": "^0.20.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "echo 'Open this directory in VSCode and then run your extension with F5 or `Run and Debug > Run Extension`!'",
    "build": "bun run ./scripts/build-with-esbuild.ts",
    "watch": "bun run ./scripts/watch-with-esbuild.ts",
    "vsce-package": "mkdir -p ../../out && vsce package --no-dependencies --out ../../out/variant-worktrees-${npm_package_version}.vsix",
    "package": "bun run build && bun run vsce-package",
    "clean": "rm -rf ./dist",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jubr/variant-worktrees.git",
    "directory": "packages/variant-vscode"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "variant",
        "label": "Variant Worktrees"
      }
    ],
    "commands": [
      {
        "command": "variant.probeCursorCommands",
        "title": "Variant: Probe Cursor Chat Commands"
      },
      {
        "command": "variant.renameExistingChats",
        "title": "Variant: Rename Existing Chats"
      },
      {
        "command": "variant.renameActiveChat",
        "title": "Variant: Rename active chat"
      },
      {
        "command": "variant.onboardingInit",
        "title": "Variant: Initialize in this Repo"
      },
      {
        "command": "variant.play",
        "title": "variant watch",
        "icon": "$(play)"
      },
      {
        "command": "variant.stop",
        "title": "Variant: Stop",
        "icon": "$(debug-stop)"
      },
      {
        "command": "variant.implode",
        "title": "Implode (would succeed)",
        "icon": {
          "light": "media/explode-light.svg",
          "dark": "media/explode-dark.svg"
        }
      },
      {
        "command": "variant.implodeDirty",
        "title": "Implode (would fail)",
        "icon": {
          "light": "media/explode-muted-light.svg",
          "dark": "media/explode-muted-dark.svg"
        }
      },
      {
        "command": "variant.showOutput",
        "title": "Variant: Show Output"
      },
      {
        "command": "variant.openUrl",
        "title": "Variant: Open URL"
      },
      {
        "command": "variant.openUrlExternal",
        "title": "Open url in external browser",
        "icon": "$(link-external)"
      },
      {
        "command": "variant.openUrlCursor",
        "title": "Open url in Cursor browser",
        "icon": "$(link-external)"
      },
      {
        "command": "variant.openPanel",
        "title": "Variant: Open Variants Panel",
        "icon": "$(layout-panel)"
      },
      {
        "command": "variant.openInBrowser",
        "title": "Variant: Open Variants in Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "variant.stopUiServer",
        "title": "Variant: Stop UI Server",
        "icon": "$(debug-stop)"
      },
      {
        "command": "variant.create",
        "title": "Create variant",
        "icon": "$(add)"
      },
      {
        "command": "variant.sort.nameAsc",
        "title": "Name (A→Z)"
      },
      {
        "command": "variant.sort.nameAscChecked",
        "title": "$(check) Name (A→Z)"
      },
      {
        "command": "variant.sort.nameDesc",
        "title": "Name (Z→A)"
      },
      {
        "command": "variant.sort.nameDescChecked",
        "title": "$(check) Name (Z→A)"
      },
      {
        "command": "variant.sort.createdAsc",
        "title": "Created (old→new)"
      },
      {
        "command": "variant.sort.createdAscChecked",
        "title": "$(check) Created (old→new)"
      },
      {
        "command": "variant.sort.createdDesc",
        "title": "Created (new→old)"
      },
      {
        "command": "variant.sort.createdDescChecked",
        "title": "$(check) Created (new→old)"
      },
      {
        "command": "variant.sort.changedAsc",
        "title": "Changed (old→new)"
      },
      {
        "command": "variant.sort.changedAscChecked",
        "title": "$(check) Changed (old→new)"
      },
      {
        "command": "variant.sort.changedDesc",
        "title": "Changed (new→old)"
      },
      {
        "command": "variant.sort.changedDescChecked",
        "title": "$(check) Changed (new→old)"
      }
    ],
    "submenus": [
      {
        "id": "variant.sort.name-asc",
        "label": "Sort: Name (A→Z)",
        "icon": "$(list-filter)"
      },
      {
        "id": "variant.sort.name-desc",
        "label": "Sort: Name (Z→A)",
        "icon": "$(list-filter)"
      },
      {
        "id": "variant.sort.created-asc",
        "label": "Sort: Created (old→new)",
        "icon": "$(list-filter)"
      },
      {
        "id": "variant.sort.created-desc",
        "label": "Sort: Created (new→old)",
        "icon": "$(list-filter)"
      },
      {
        "id": "variant.sort.changed-asc",
        "label": "Sort: Changed (old→new)",
        "icon": "$(list-filter)"
      },
      {
        "id": "variant.sort.changed-desc",
        "label": "Sort: Changed (new→old)",
        "icon": "$(list-filter)"
      }
    ],
    "configuration": {
      "title": "Variant Worktrees",
      "properties": {
        "variant.autoExpand": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Expand the Variant Worktrees section when the editor starts and the workspace already uses variants or looks ready for them, then return focus to the editor. `false` leaves the section as it was. A workspace with nothing to detect is not expanded. Default `true`."
        },
        "variant.sort": {
          "type": "string",
          "enum": [
            "name-asc",
            "name-desc",
            "created-asc",
            "created-desc",
            "changed-asc",
            "changed-desc"
          ],
          "default": "name-asc",
          "markdownDescription": "Order of the Variant Worktrees section and the Variants panel. `name` is the slug. `created` is `runtime.createdAt` (`YYYY-MM-DD_HH:MM:SS`) read as local time, or the directory creation time when that stamp is missing. `changed` is the later modification time of the variant directory and `variants.local.yaml`. A missing time sorts as older than every known time. `main` stays first. Default `name-asc`."
        },
        "variant.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Turn chat renaming on or off. `false` stops title-event renames, hook installation, and renaming of existing chats. Palette rename commands stay available and tell you this setting is off. Default `true`. Changing it applies without a reload."
        },
        "variant.trigger": {
          "type": "string",
          "enum": [
            "titleEvent",
            "hook"
          ],
          "default": "titleEvent",
          "enumDescriptions": [
            "Listen to Cursor's chat title change event (cursor.onDidChangeAgentHostSessionCatalogTitle) and rename when the first prompt is a rename request.",
            "Install a beforeSubmitPrompt hook in the Cursor hooks.json that sends rename requests to this extension and blocks lone /chat-rename prompts from the model."
          ],
          "markdownDescription": "What triggers a rename. Experimental: relies on private Cursor internals and may stop working on a Cursor update."
        },
        "variant.activationPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "/[a-z]+-spec-[a-z]+\\s+@\\S+/[A-Za-z0-9_]+-([A-Za-z0-9_-]+)/?(?=\\s|$)",
            "/[a-z]+-spec-[a-z]+\\s+@_work-([A-Za-z0-9_-]+)/?(?=\\s|$)",
            "/[a-z]+-spec-[a-z]+\\s+([A-Za-z0-9_-]+)"
          ],
          "markdownDescription": "JavaScript regular expressions tested against each line of the first prompt of a chat. A match renames the chat to its first capture group (or the whole match). The default list is a path pattern, a short `_work-` pattern, then a slug pattern. `/vw-spec-iterate @/Users/me/_v-outer/_v-inner` becomes `inner` (the last path segment after its leading prefix token), `/vw-spec-start @_work-my-slug` becomes `my-slug`, and `/vw-spec-start my-slug` becomes `my-slug`. A pattern title that already ends in digits is kept (`abc7` beside `abc` stays `abc7`). A title with no trailing digits is numbered against other open chats: `abc` becomes `abc2`, and with `def3` and `def5` open `def` becomes `def6`. `/chat-rename` and `/rename-chat` always work and are not numbered. When worktree prefixes are set, the default path pattern is left out and only those prefixes match an `@` path. In `hook` mode the patterns are copied into the hook script, which evaluates them with Python's `re`; change the setting to reinstall it."
        },
        "variant.worktreePrefixes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Prefixes of worktree directories, each with its own leading character and connector (`_v-` in `_v-my-slug`). A first prompt such as `/vw-spec-iterate @/path/_v-my-slug`, which is what dragging a worktree folder into the chat produces, renames the chat `my-slug`. Empty by default, which turns this off; Variant fills it from `variant.prefix` in `variants.yaml` unless you list prefixes here."
        },
        "variant.renameExistingDays": {
          "type": "integer",
          "minimum": 0,
          "default": 7,
          "markdownDescription": "How many days back to rename chats that already existed when the editor started. Chats whose first prompt matches an activation pattern or `/chat-rename` are renamed oldest first, numbered per title (`abc`, `abc2`, `abc3`), once per chat. `0` turns it off (default `7`). Changing it applies without a reload; the log lines starting with `[existing-chats]` name this setting and its value."
        },
        "variant.titleEventPromptLines": {
          "type": "integer",
          "minimum": 1,
          "default": 10,
          "markdownDescription": "How many lines of a new chat's first prompt the title event tests for a rename request (default `10`, at least `1`). A slash command or activation pattern on a later line does not rename the chat. The lines read are written to the log channel at Trace level (select Trace in the channel's log level picker), and every decision is logged as a `[title-event]` line. Applies to the `titleEvent` trigger only. Changing it applies without a reload."
        },
        "variant.hookScope": {
          "type": "string",
          "enum": [
            "workspace",
            "user"
          ],
          "default": "workspace",
          "enumDescriptions": [
            "Write `.cursor/hooks.json` in the first workspace folder.",
            "Write `~/.cursor/hooks.json`."
          ],
          "markdownDescription": "Which hooks.json receives the hook when `#variant.trigger#` is `hook`."
        },
        "variant.mise.binPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path of the [Mise](https://mise.jdx.dev) executable that Variant Worktrees runs to read the environment of a project, list its configuration files and trust them. Empty: the `variant.mise.binPath` key of `variants.yaml`, then `mise` on `PATH`, then the usual install locations. Changing it applies to the next call without a reload."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "variantWorktrees",
          "title": "Variant Worktrees",
          "icon": "media/vw-mini-icon.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "variant.variants",
          "name": "Variant Worktrees",
          "when": "workspaceFolderCount > 0 && !variant.onboardingOpen",
          "visibility": "collapsed"
        },
        {
          "id": "variant.onboarding",
          "name": "Variant Worktrees",
          "type": "webview",
          "when": "workspaceFolderCount > 0 && variant.onboardingOpen",
          "visibility": "visible"
        }
      ],
      "variantWorktrees": [
        {
          "id": "variant.worktrees",
          "name": "Variant Worktrees",
          "when": "workspaceFolderCount > 0",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "variant.variants",
        "contents": "Variants are not initialized in this workspace.\n[Onboard](command:variant.onboardingInit)",
        "when": "variant.noConfig"
      },
      {
        "view": "variant.variants",
        "contents": "Variants are not initialized, but no variants created yet.\n[Onboard](command:variant.create)",
        "when": "variant.noVariants"
      },
      {
        "view": "variant.worktrees",
        "contents": "Variants are not initialized in this workspace.\n[Onboard](command:variant.onboardingInit)",
        "when": "variant.noConfig"
      },
      {
        "view": "variant.worktrees",
        "contents": "Variants are not initialized, but no variants created yet.\n[Onboard](command:variant.create)",
        "when": "variant.noVariants"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "variant.play",
          "when": "false"
        },
        {
          "command": "variant.stop",
          "when": "false"
        },
        {
          "command": "variant.implode",
          "when": "false"
        },
        {
          "command": "variant.implodeDirty",
          "when": "false"
        },
        {
          "command": "variant.showOutput",
          "when": "false"
        },
        {
          "command": "variant.openUrl",
          "when": "false"
        },
        {
          "command": "variant.openUrlExternal",
          "when": "false"
        },
        {
          "command": "variant.openUrlCursor",
          "when": "false"
        },
        {
          "command": "variant.stopUiServer",
          "when": "false"
        },
        {
          "command": "variant.openPanel",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "variant.openInBrowser",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "variant.onboardingInit",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "variant.create",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "variant.sort.nameAscChecked",
          "when": "false"
        },
        {
          "command": "variant.sort.nameDescChecked",
          "when": "false"
        },
        {
          "command": "variant.sort.createdAscChecked",
          "when": "false"
        },
        {
          "command": "variant.sort.createdDescChecked",
          "when": "false"
        },
        {
          "command": "variant.sort.changedAscChecked",
          "when": "false"
        },
        {
          "command": "variant.sort.changedDescChecked",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "variant.create",
          "when": "(view == variant.variants || view == variant.worktrees)",
          "group": "navigation@0"
        },
        {
          "submenu": "variant.sort.name-asc",
          "when": "(view == variant.variants || view == variant.worktrees) && variant.currentSort == 'name-asc'",
          "group": "navigation@1"
        },
        {
          "submenu": "variant.sort.name-desc",
          "when": "(view == variant.variants || view == variant.worktrees) && variant.currentSort == 'name-desc'",
          "group": "navigation@1"
        },
        {
          "submenu": "variant.sort.created-asc",
          "when": "(view == variant.variants || view == variant.worktrees) && variant.currentSort == 'created-asc'",
          "group": "navigation@1"
        },
        {
          "submenu": "variant.sort.created-desc",
          "when": "(view == variant.variants || view == variant.worktrees) && variant.currentSort == 'created-desc'",
          "group": "navigation@1"
        },
        {
          "submenu": "variant.sort.changed-asc",
          "when": "(view == variant.variants || view == variant.worktrees) && variant.currentSort == 'changed-asc'",
          "group": "navigation@1"
        },
        {
          "submenu": "variant.sort.changed-desc",
          "when": "(view == variant.variants || view == variant.worktrees) && variant.currentSort == 'changed-desc'",
          "group": "navigation@1"
        },
        {
          "command": "variant.openPanel",
          "when": "(view == variant.variants || view == variant.worktrees)",
          "group": "navigation@2"
        },
        {
          "command": "variant.openInBrowser",
          "when": "(view == variant.variants || view == variant.worktrees)",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "variant.openUrlExternal",
          "alt": "variant.openUrlCursor",
          "when": "(view == variant.variants || view == variant.worktrees) && viewItem =~ /^variant (down|up|watching) .*has-url/",
          "group": "inline@0"
        },
        {
          "command": "variant.play",
          "when": "(view == variant.variants || view == variant.worktrees) && viewItem =~ /^variant down( |$)/",
          "group": "inline@1"
        },
        {
          "command": "variant.stop",
          "when": "(view == variant.variants || view == variant.worktrees) && viewItem =~ /^variant (watching|up)( |$)/",
          "group": "inline@2"
        },
        {
          "command": "variant.implode",
          "when": "(view == variant.variants || view == variant.worktrees) && viewItem =~ /^variant (down|up|watching) removable/ && viewItem =~ / clean/",
          "group": "inline@9"
        },
        {
          "command": "variant.implodeDirty",
          "when": "(view == variant.variants || view == variant.worktrees) && viewItem =~ /^variant (down|up|watching) removable/ && viewItem =~ / dirty/",
          "group": "inline@9"
        },
        {
          "command": "variant.showOutput",
          "when": "(view == variant.variants || view == variant.worktrees) && viewItem =~ /^variant (down|up|watching) .*has-log/",
          "group": "1_output@1"
        },
        {
          "command": "variant.openUrl",
          "when": "(view == variant.variants || view == variant.worktrees) && viewItem =~ /^variant (down|up|watching) .*has-url/",
          "group": "1_output@2"
        },
        {
          "command": "variant.openPanel",
          "when": "(view == variant.variants || view == variant.worktrees) && viewItem =~ /^variant (down|up|watching) /",
          "group": "2_open@1"
        },
        {
          "command": "variant.openInBrowser",
          "when": "(view == variant.variants || view == variant.worktrees) && viewItem =~ /^variant (down|up|watching) /",
          "group": "2_open@2"
        },
        {
          "command": "variant.openInBrowser",
          "when": "(view == variant.variants || view == variant.worktrees) && viewItem =~ /^ui-server$/",
          "group": "inline@1"
        },
        {
          "command": "variant.stopUiServer",
          "when": "(view == variant.variants || view == variant.worktrees) && viewItem =~ /^ui-server$/",
          "group": "inline@2"
        }
      ],
      "variant.sort.name-asc": [
        { "command": "variant.sort.nameAscChecked", "group": "1_sort@1" },
        { "command": "variant.sort.nameDesc", "group": "1_sort@2" },
        { "command": "variant.sort.createdAsc", "group": "1_sort@3" },
        { "command": "variant.sort.createdDesc", "group": "1_sort@4" },
        { "command": "variant.sort.changedAsc", "group": "1_sort@5" },
        { "command": "variant.sort.changedDesc", "group": "1_sort@6" }
      ],
      "variant.sort.name-desc": [
        { "command": "variant.sort.nameAsc", "group": "1_sort@1" },
        { "command": "variant.sort.nameDescChecked", "group": "1_sort@2" },
        { "command": "variant.sort.createdAsc", "group": "1_sort@3" },
        { "command": "variant.sort.createdDesc", "group": "1_sort@4" },
        { "command": "variant.sort.changedAsc", "group": "1_sort@5" },
        { "command": "variant.sort.changedDesc", "group": "1_sort@6" }
      ],
      "variant.sort.created-asc": [
        { "command": "variant.sort.nameAsc", "group": "1_sort@1" },
        { "command": "variant.sort.nameDesc", "group": "1_sort@2" },
        { "command": "variant.sort.createdAscChecked", "group": "1_sort@3" },
        { "command": "variant.sort.createdDesc", "group": "1_sort@4" },
        { "command": "variant.sort.changedAsc", "group": "1_sort@5" },
        { "command": "variant.sort.changedDesc", "group": "1_sort@6" }
      ],
      "variant.sort.created-desc": [
        { "command": "variant.sort.nameAsc", "group": "1_sort@1" },
        { "command": "variant.sort.nameDesc", "group": "1_sort@2" },
        { "command": "variant.sort.createdAsc", "group": "1_sort@3" },
        { "command": "variant.sort.createdDescChecked", "group": "1_sort@4" },
        { "command": "variant.sort.changedAsc", "group": "1_sort@5" },
        { "command": "variant.sort.changedDesc", "group": "1_sort@6" }
      ],
      "variant.sort.changed-asc": [
        { "command": "variant.sort.nameAsc", "group": "1_sort@1" },
        { "command": "variant.sort.nameDesc", "group": "1_sort@2" },
        { "command": "variant.sort.createdAsc", "group": "1_sort@3" },
        { "command": "variant.sort.createdDesc", "group": "1_sort@4" },
        { "command": "variant.sort.changedAscChecked", "group": "1_sort@5" },
        { "command": "variant.sort.changedDesc", "group": "1_sort@6" }
      ],
      "variant.sort.changed-desc": [
        { "command": "variant.sort.nameAsc", "group": "1_sort@1" },
        { "command": "variant.sort.nameDesc", "group": "1_sort@2" },
        { "command": "variant.sort.createdAsc", "group": "1_sort@3" },
        { "command": "variant.sort.createdDesc", "group": "1_sort@4" },
        { "command": "variant.sort.changedAsc", "group": "1_sort@5" },
        { "command": "variant.sort.changedDescChecked", "group": "1_sort@6" }
      ]
    }
  }
}
