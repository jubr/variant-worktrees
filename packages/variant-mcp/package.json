{
  "name": "variant-mcp",
  "version": "0.0.13",
  "description": "Database variants as an MCP server for AI clients",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./bundle": "./src/server.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/server.d.ts",
        "import": "./dist/server.js"
      }
    }
  },
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/server.ts --outdir dist --target node --format esm --sourcemap=external --external zod --external @modelcontextprotocol/sdk --external variant-api --external variant-config --external variant-ipc --external variant-log",
    "build:types": "tsc --emitDeclarationOnly",
    "mcp": "bun run src/mcp.ts",
    "mcp:inspect": "npx @modelcontextprotocol/inspector variant mcp",
    "prepublishOnly": "bun run build",
    "test": "VARIANT_OPEN=0 bun test"
  },
  "homepage": "https://github.com/jubr/variant-worktrees",
  "repository": {
    "type": "git",
    "url": "https://github.com/jubr/variant-worktrees.git",
    "directory": "packages/variant-mcp"
  },
  "keywords": [
    "variant",
    "mcp",
    "model-context-protocol",
    "ai",
    "claude",
    "cursor"
  ],
  "files": [
    "dist"
  ],
  "author": "Jurgen Braam (@jubr)",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "variant-api": "workspace:*",
    "variant-config": "workspace:*",
    "variant-ipc": "workspace:*",
    "variant-log": "workspace:*",
    "zod": "^4.3.6"
  }
}
